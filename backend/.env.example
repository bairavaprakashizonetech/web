# Database configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=taskmanager
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Database URL (PostgreSQL by default, or sqlite:///./tasks.db for local file DB)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/taskmanager

# CORS Settings (comma-separated allowed origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:80,http://127.0.0.1:5173

# Application Settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
